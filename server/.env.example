PORT=5000

# MongoDB Atlas connection string — see README.md for how to create this.
MONGODB_URI=

# Any long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origins allowed to send authenticated requests (no trailing slash).
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

NODE_ENV=development

# --- Media storage (Cloudflare R2) — only required once you use /admin/media ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
