PORT=5000

# MongoDB Atlas connection string — see README.md for how to create this.
MONGODB_URI=

# Any long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origins allowed to send authenticated requests (no trailing slash).
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

NODE_ENV=development

# How many reverse-proxy hops sit in front of this server in production
# (Express's "trust proxy" setting) — needed for IP-based rate limiting to
# see the real client IP instead of the proxy's. 1 is correct for a single
# PaaS proxy (Render/Railway/Fly). Leave at 0 for local dev (no proxy).
# If you ever put Cloudflare in front of one of those too, this needs to
# be 2 (or an explicit trusted-IP list) instead.
TRUST_PROXY_HOPS=0

# Dev-only, opt-in: works around Node's default DNS resolver refusing
# mongodb+srv:// SRV lookups on some Windows/VPN/router setups (OS-level
# tools like nslookup still work fine there). Never applies in production —
# leave unset there; a real host's own DNS doesn't have this problem.
# Comma-separated. Leave blank/unset to disable (default Node resolver).
DEV_DNS_SERVERS=

# --- Media storage (Cloudflare R2) — only required once you use /admin/media ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
