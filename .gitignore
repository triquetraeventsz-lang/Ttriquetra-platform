node_modules
dist
dist-ssr
*.local

# Environment variables — never commit real secrets
.env
.env.*
!.env.example
# Catches env/credential files regardless of prefix (e.g. a MongoDB Atlas
# "atlas-credentials.env" export) — the exact gap that let one such file
# sit untracked-but-unignored and servable by the dev server. Applies
# anywhere in the repo, not just the root.
*.env
*credentials*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
server/scripts/_dev-local-mongo.mjs
